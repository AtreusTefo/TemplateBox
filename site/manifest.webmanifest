{
    "name": "TemplateBox - Invoice, Receipt and Resume Maker",
    "short_name": "TemplateBox",
    "description": "Create invoices, receipts, resumes, posters and product mockups free in your browser. No sign-up, no database, nothing leaves your device.",
    "id": "/",
